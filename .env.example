# Базовый URL API (без завершающего слэша) — используется в src/api/client.ts.
#
# Варианты:
#   Android-эмулятор:   http://10.0.2.2:8000/api/v1
#   iOS-симулятор:      http://localhost:8000/api/v1
#   Физическое устройство (телефон в той же Wi-Fi сети, что и ПК):
#                       http://<IP-компьютера>:8000/api/v1
#   Прод:               https://volley-hub.ru/api/v1
#
# Скопируйте этот файл в .env и подставьте свой адрес.
EXPO_PUBLIC_API_URL=https://volley-hub.ru/api/v1
